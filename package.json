{
  "name": "seed-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:engine": "node --test tests/engine.test.mjs",
    "preview:install": "npm --prefix preview-service install",
    "preview:eula": "npm --prefix preview-service run accept-eula",
    "preview:start": "npm --prefix preview-service start",
    "test:preview": "npm --prefix preview-service test"
  },
  "dependencies": {
    "lucide-react": "^1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.0.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.40.0",
    "vite": "8.0.13"
  }
}
